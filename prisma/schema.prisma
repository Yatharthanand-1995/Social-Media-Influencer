generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================
// AUTHENTICATION MODELS (NextAuth.js)
// ===================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // For credentials provider (hashed with bcrypt)
  image         String?
  role          UserRole  @default(BRAND)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  brandId       String?   @unique @map("brand_id")
  brand         Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===================================
// APPLICATION MODELS
// ===================================


enum Platform {
  instagram
  youtube
  tiktok
  twitter
}

enum ContentType {
  post
  story
  reel
  video
  short
  tweet
}

enum UserRole {
  ADMIN
  BRAND
  INFLUENCER
}

model Influencer {
  id                String   @id @default(uuid())
  name              String
  profileImageUrl   String?  @map("profile_image_url")
  bio               String?
  primaryPlatform   Platform @map("primary_platform")
  niche             String[]
  location          String?
  createdAt         DateTime @default(now()) @map("created_at")

  socialAccounts    SocialAccount[]

  @@index([primaryPlatform])
  @@index([location])
  @@index([createdAt])
  @@index([primaryPlatform, location])
  @@map("influencers")
}

model SocialAccount {
  id              String    @id @default(uuid())
  influencerId    String    @map("influencer_id")
  platform        Platform
  handle          String
  followersCount  Int       @map("followers_count")
  avgViews        Int?      @map("avg_views")
  avgLikes        Int       @map("avg_likes")
  avgComments     Int       @map("avg_comments")
  engagementRate  Float     @map("engagement_rate")
  lastUpdated     DateTime  @default(now()) @map("last_updated")

  influencer           Influencer            @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  audienceDemographics AudienceDemographics?
  pricing              Pricing[]

  @@index([platform])
  @@index([followersCount])
  @@index([engagementRate])
  @@index([influencerId, platform])
  @@map("social_accounts")
}

model AudienceDemographics {
  id               String  @id @default(uuid())
  socialAccountId  String  @unique @map("social_account_id")
  ageGroup         Json    @map("age_group")
  genderSplit      Json    @map("gender_split")
  topCountries     String[] @map("top_countries")
  interests        String[]

  socialAccount    SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId])
  @@map("audience_demographics")
}

model Pricing {
  id              String      @id @default(uuid())
  socialAccountId String      @map("social_account_id")
  contentType     ContentType @map("content_type")
  priceMin        Float       @map("price_min")
  priceMax        Float?      @map("price_max")
  currency        String      @default("USD")

  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("pricing")
}

model Brand {
  id              String   @id @default(uuid())
  name            String
  industry        String?
  website         String?
  description     String?
  logo            String?
  targetAudience  Json?    @map("target_audience")
  budgetRange     String?  @map("budget_range")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User?    // One-to-one with User

  @@map("brands")
}
